# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env with real secrets.

# --- Server ---
NODE_ENV=development
PORT=5001
BACKEND_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173

# --- Database (MongoDB) ---
DB_CONNECT_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# --- Auth (legacy JWT) ---
JWT_KEY=<generate-a-long-random-string>

# --- Clerk (primary auth) ---
CLERK_PUBLISHABLE_KEY=pk_test_<your-key>
CLERK_SECRET_KEY=sk_test_<your-key>

# --- Code execution (Judge0 via RapidAPI) ---
JUDGE0_API_KEY=<your-rapidapi-key>

# --- AI hints / chat / study plans (OpenRouter, OpenAI-compatible) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=<your-openrouter-key>
# Free OpenRouter model (":free" suffix = no charge, rate-limited).
# Verified live against https://openrouter.ai/api/v1/models — free models
# rotate often, so re-check that page if you get "model unavailable" errors.
# Chinese free alternatives (availability varies):
# "minimax/minimax-m3:free" (MiniMax, 1M context),
# "moonshotai/kimi-k2.6:free" (Moonshot AI),
# "deepseek/deepseek-chat-v3-0324:free" (DeepSeek, when free).
# NOTE: avoid reasoning models (e.g. DeepSeek R1) — their thinking tags
# break the JSON responses used by AI-fix and study-plan endpoints.
AI_MODEL=qwen/qwen3.8-27b:free
# Optional overrides (defaults: https://openrouter.ai/api/v1 / AlgoForge)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_APP_NAME=AlgoForge

# --- Email (OTP / password reset via Nodemailer) ---
EMAIL_USER=<your-gmail-address>
EMAIL_PASS=<your-gmail-app-password>

# --- Social login (Passport, optional) ---
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>
